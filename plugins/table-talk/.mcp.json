{
  "mcpServers": {
    "sql-explorer-mcp": {
      "command": "uv",
      "args": [
        "run", "--quiet", "--locked",
        "--script", "${CLAUDE_PLUGIN_ROOT}/scripts/sql-explorer.py"
      ],
      "env": {
        "FABRIC_SQL_ENDPOINT": "${FABRIC_SQL_ENDPOINT:-}",
        "FABRIC_DATABASE": "${FABRIC_DATABASE:-}",
        "MCP_TRANSPORT": "stdio",
        "UV_CACHE_DIR": "${CLAUDE_PLUGIN_DATA}/uv-cache",
        "UV_PYTHON_INSTALL_DIR": "${CLAUDE_PLUGIN_DATA}/python"
      }
    }
  }
}
